[
  {
    "title": "Hero",
    "id": "hero",
    "model": "hero",
    "plugins": {
      "da": {
        "name": "hero",
        "rows": 8,
        "columns": 1,
        "fields": [
          { "name": "image", "selector": "div:nth-child(1)" },
          { "name": "title", "selector": "div:nth-child(2)" },
          { "name": "subtitle", "selector": "div:nth-child(3)" },
          { "name": "ctaPrimaryText", "selector": "div:nth-child(4)" },
          { "name": "ctaPrimaryHref", "selector": "div:nth-child(5)" },
          { "name": "ctaSecondaryText", "selector": "div:nth-child(6)" },
          { "name": "ctaSecondaryHref", "selector": "div:nth-child(7)" },
          { "name": "theme", "selector": "div:nth-child(8)" }
        ]
      }
    }
  },
  {
    "title": "Car Showcase Grid",
    "id": "car-grid",
    "model": "car-grid",
    "plugins": { "da": { "name": "car-grid", "type": "key-value-block" } }
  },
  {
    "title": "Color Visualizer",
    "id": "color-picker",
    "model": "color-picker",
    "plugins": { "da": { "name": "color-picker", "type": "key-value-block" } }
  },
  {
    "title": "Specs Comparison Table",
    "id": "specs-table",
    "model": "specs-table",
    "plugins": { "da": { "name": "specs-table", "type": "key-value-block" } }
  },
  {
    "title": "Dealer Search",
    "id": "dealer-search",
    "model": "dealer-search",
    "plugins": { "da": { "name": "dealer-search", "type": "key-value-block" } }
  }
]
